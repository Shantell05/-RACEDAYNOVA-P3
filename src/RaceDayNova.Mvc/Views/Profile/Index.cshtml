@model ProfileFormModel
@{ ViewData["Title"] = "My profile"; }<div class="form-layout"><div class="section-head"><div><div class="eyebrow">YOUR ACCOUNT</div><h1>Profile & settings</h1><p class="muted">Keep your contact details up to date.</p></div></div><div class="form-card">@if (!string.IsNullOrWhiteSpace(ViewBag.ProfileImageUrl as string)) { <img src="@ViewBag.ProfileImageUrl" alt="Your profile picture" style="width:92px;height:92px;border-radius:50%;object-fit:cover;margin-bottom:18px"/> }<form asp-action="Index" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" autocomplete="given-name"/><span asp-validation-for="FirstName" class="validation"></span></div><div class="field"><label asp-for="LastName"></label><input asp-for="LastName" autocomplete="family-name"/><span asp-validation-for="LastName" class="validation"></span></div><div class="field full"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email" class="validation"></span></div><div class="field full"><label asp-for="Mobile"></label><input asp-for="Mobile"/></div></div><hr style="border:0;border-top:1px solid var(--line);margin:10px 0 22px"/><h3>Change password <small class="muted">(optional)</small></h3><div class="form-grid"><div class="field"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password"/></div><div class="field"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password"/></div></div><div class="field"><label asp-for="ProfilePicture">Profile picture</label><input asp-for="ProfilePicture" type="file" accept="image/png,image/jpeg,image/webp"/><small class="muted">Image upload is handled through the Part 2 API.</small></div><button class="btn" type="submit">Save profile changes ↗</button></form></div><div class="form-card" style="margin-top:20px"><h3>Account type</h3>@{ var currentRole = Context.Session.GetString("UserRole"); var targetRole = currentRole == "Organiser" ? "Participant" : "Organiser"; }<p class="muted">You are currently using RaceDay Nova as @(currentRole == "Organiser" ? "an Organiser" : "a Participant"). @(targetRole == "Organiser" ? "Switch to Organiser to create events, add categories and publish results." : "Switch to Participant to browse and enter events.")</p><form asp-action="SwitchRole" method="post"><input type="hidden" name="role" value="@targetRole"/><button class="btn" type="submit">Switch to @targetRole ↗</button></form></div></div>
