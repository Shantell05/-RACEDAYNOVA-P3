@model List<ResultDto>
@{ ViewData["Title"] = "My results"; }<div class="section-head"><div><div class="eyebrow">YOUR RACE HISTORY</div><h1>My results</h1><p class="muted">A record of your race-day effort, finish times and positions.</p></div><a class="btn btn-light" asp-controller="Participant" asp-action="MyEvents">← My entries</a></div>@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">🏆</div><h3>Your results will appear here</h3><p>After an organiser records your finish, you will be able to see your race history here.</p><a class="btn" asp-controller="Home" asp-action="Index">Find a race</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach (var r in Model.OrderByDescending(x=>x.EventDate)) { <tr><td><strong>@r.EventName</strong></td><td>@r.EventDate.ToString("dd MMM yyyy")</td><td>@r.CategoryName</td><td>@(r.FinishTime?.ToString("hh':'mm':'ss") ?? "—")</td><td>@(r.PositionNo?.ToString() ?? "—")</td><td><span class="status status-@r.ResultStatus.ToLowerInvariant()">@r.ResultStatus</span></td></tr> }</tbody></table></div> }
