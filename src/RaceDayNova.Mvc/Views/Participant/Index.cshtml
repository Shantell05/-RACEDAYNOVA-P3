@model List<EventDto>
@{ ViewData["Title"] = "Participant home"; var entries = ViewBag.Enrolments as List<EnrolmentDto> ?? new(); }
<section class="hero"><div><div class="eyebrow" style="color:#b8f36b">YOUR RACEDAY JOURNEY</div><h1>Ready when <span>you are.</span></h1><p>Discover your next challenge, keep your entries in one place and celebrate every finish line.</p><a class="btn" asp-controller="Home" asp-action="Index">Explore all events ↗</a></div><div class="hero-side"><div class="eyebrow" style="color:#b8f36b">YOUR JOURNEY SO FAR</div><div class="big">@entries.Count</div><h3>Event entries</h3><p>Every race starts with showing up. Keep going.</p><a class="btn btn-light" asp-action="MyEvents">View my entries</a></div></section>
<div class="section-head"><div><div class="eyebrow">YOUR ENTRIES</div><h2>Upcoming race days</h2></div><a asp-action="MyEvents">View all my entries ↗</a></div>@if (entries.Count > 0) { <div class="table-wrap"><table><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach (var e in entries.OrderBy(x=>x.EventDate)) { <tr><td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId"><strong>@e.EventName</strong></a></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td><span class="status status-@e.EnrolmentStatus.ToLowerInvariant()">@e.EnrolmentStatus</span></td></tr> }</tbody></table></div> } else { <div class="panel"><p class="muted">You have not entered an event yet. Browse the event calendar and choose your first challenge.</p></div>}
<div class="section-head"><div><div class="eyebrow">FIND YOUR NEXT CHALLENGE</div><h2>Upcoming events</h2></div></div><div class="event-grid">@foreach (var e in Model.Where(x=>x.EventDate >= DateOnly.FromDateTime(DateTime.Today) && x.EventStatus != "Cancelled").Take(6)) { <article class="event-card"><div class="event-art">@if (!string.IsNullOrWhiteSpace(e.BannerImageUrl)) { <img src="@e.BannerImageUrl" alt="@e.EventName banner"/> }<span>@e.EventType.ToUpperInvariant()</span></div><div class="event-body"><span class="tag">@e.EventStatus</span><h3>@e.EventName</h3><p>📍 @e.City</p><div class="event-meta"><span>📅 @e.EventDate.ToString("dd MMM yyyy")</span><span>↗ @e.DistanceKm km</span></div><a class="btn btn-dark" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View event ↗</a></div></article> }</div>
