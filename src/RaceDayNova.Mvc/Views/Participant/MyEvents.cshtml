@model List<EnrolmentDto>
@{ ViewData["Title"] = "My entries"; }<div class="section-head"><div><div class="eyebrow">YOUR RACE CALENDAR</div><h1>My event entries</h1><p class="muted">All your entries, categories and current enrolment statuses in one place.</p></div><a class="btn" asp-controller="Home" asp-action="Index">＋ Find an event</a></div>@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">👟</div><h3>Your next race is waiting</h3><p>Once you enter an event, you will see the details here.</p><a class="btn" asp-controller="Home" asp-action="Index">Explore events</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Fee</th><th>Entry status</th><th>Action</th></tr></thead><tbody>@foreach (var e in Model.OrderBy(x=>x.EventDate)) { <tr><td><strong>@e.EventName</strong><br/><small class="muted">Event #@e.EventId</small></td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.CategoryName</td><td>R @e.EntryFee.ToString("0.00")</td><td><span class="status status-@e.EnrolmentStatus.ToLowerInvariant()">@e.EnrolmentStatus</span></td><td><div class="actions"><a class="btn btn-small btn-light" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">Details</a>@if (!e.HasResult && e.EnrolmentStatus != "Cancelled") { <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@e.EnrolmentId"/><button class="btn btn-small btn-danger" type="submit" data-confirm="Cancel this event entry?">Cancel entry</button></form> }</div></td></tr> }</tbody></table></div> }
