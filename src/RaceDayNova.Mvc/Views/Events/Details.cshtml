@model EventDto
@{ ViewData["Title"] = Model.EventName; var categories = ViewBag.Categories as List<EventCategoryDto> ?? Model.Categories; var weather = ViewBag.Weather as WeatherViewModel; }
<section class="detail-hero"><div><div class="eyebrow" style="color:#b8f36b">@Model.EventType · @Model.EventStatus</div><h1>@Model.EventName</h1><p>@Model.Description</p><div class="event-meta" style="color:#d0ddd5"><span>📅 @Model.EventDate.ToString("dddd, dd MMMM yyyy")</span><span>◉ @Model.StartTime.ToString("HH:mm")</span><span>📍 @Model.Venue, @Model.City, @Model.Province</span></div><a class="btn btn-light" asp-controller="Home" asp-action="Index">← Back to events</a></div><div class="detail-distance"><span class="eyebrow" style="color:#b8f36b">THE DISTANCE</span><strong>@Model.DistanceKm km</strong><span>Every kilometre counts.</span><p style="margin-top:18px"><span class="tag">@Model.EventStatus</span></p></div></section>
@if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl)) { <img src="@Model.BannerImageUrl" alt="@Model.EventName banner" style="display:block;width:100%;max-height:330px;object-fit:cover;border-radius:20px;margin-top:18px"/> }
<div class="detail-columns"><section class="panel"><div class="eyebrow">CHOOSE YOUR CHALLENGE</div><h2>Available categories</h2>@if (categories.Count == 0) { <p class="muted">No categories have been attached to this event yet. Check back soon.</p> } else { <div class="table-wrap"><table><thead><tr><th>Category</th><th>Entry fee</th><th>Places</th><th>Enter</th></tr></thead><tbody>@foreach (var c in categories) { <tr><td><strong>@c.CategoryName</strong><br/><small class="muted">@c.CategoryNote</small></td><td>R @c.EntryFee.ToString("0.00")</td><td>@(c.PlacesAvailable.HasValue ? Math.Max(0,c.PlacesAvailable.Value-c.EnrolmentCount).ToString() : "Open")</td><td>@if (Context.Session.GetString("UserRole") == "Participant" && Model.EventStatus != "Closed" && Model.EventStatus != "Cancelled" && Model.EventStatus != "Completed") { <form asp-controller="Participant" asp-action="Enrol" method="post"><input type="hidden" name="id" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-small" type="submit">Enter event ↗</button></form> } else if (!Context.Session.GetInt32("UserId").HasValue) { <a class="btn btn-small" asp-controller="Auth" asp-action="Login">Log in to enter</a> } else { <span class="muted">Entry unavailable</span> }</td></tr> }</tbody></table></div> }</section>
<aside><section class="panel"><div class="eyebrow">EVENT DETAILS</div><h3>Everything you need</h3><p><strong>Venue</strong><br/>@Model.Venue</p><p><strong>Location</strong><br/>@Model.City, @Model.Province</p><p><strong>Organised by</strong><br/>@Model.OrganiserName</p><p><strong>Route information</strong><br/>@(Model.RouteReference ?? "Route details will be shared by the organiser.")</p></section><section class="panel"><div class="eyebrow">RACE DAY CONDITIONS</div><h3>Weather snapshot</h3>@if (weather != null) { <div class="weather-grid"><div class="weather-item"><strong>@(weather.TemperatureC?.ToString("0") ?? "—")°C</strong><span>Temperature</span></div><div class="weather-item"><strong>@(weather.WindKph?.ToString("0") ?? "—")</strong><span>Wind km/h</span></div><div class="weather-item"><strong>@(weather.RainChance?.ToString("0") ?? "—")%</strong><span>Rain chance</span></div></div><p class="muted">@weather.Summary</p><small class="muted">Weather is indicative and may change.</small> } else { <p class="muted">Weather information is temporarily unavailable.</p> }</section></aside></div>
