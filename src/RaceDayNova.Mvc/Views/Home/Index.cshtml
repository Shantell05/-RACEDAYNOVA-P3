@model List<EventDto>
@{ ViewData["Title"] = "Find your next event"; }
<section class="hero"><div><div class="eyebrow" style="color:#b8f36b">YOUR NEXT FINISH LINE STARTS HERE</div><h1>Find your pace.<br/><span>Find your people.</span></h1><p>Discover running, walking and cycling events across South Africa. Pick a challenge, bring your energy, and make your next race day count.</p><a class="btn" asp-controller="Auth" asp-action="Register">Get started&nbsp; ↗</a> <a class="btn btn-light" asp-controller="Home" asp-action="Index">Explore events</a></div><div class="hero-side"><div class="eyebrow" style="color:#b8f36b">THE STARTING LINE</div><div class="big">01.</div><h3>One community. Every pace.</h3><p>From your first 5K to your next personal best, there is a place for you on the start line.</p></div></section>
<div class="section-head"><div><div class="eyebrow">THE EVENT CALENDAR</div><h2>Find your next adventure</h2><div class="subtext">Browse upcoming events and find the right challenge for you.</div></div><span class="tag">@Model.Count events found</span></div>
<form method="get" class="filters"><div class="field" style="margin:0"><label for="search">Search events</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Event, venue or city"/></div><div class="field" style="margin:0"><label for="eventType">Activity</label><select id="eventType" name="eventType"><option value="">All activities</option><option selected="@(ViewBag.EventType == "Running")">Running</option><option selected="@(ViewBag.EventType == "Walking")">Walking</option><option selected="@(ViewBag.EventType == "Cycling")">Cycling</option></select></div><div class="field" style="margin:0"><label for="city">City</label><input id="city" name="city" value="@ViewBag.City" placeholder="e.g. Pretoria"/></div><button class="btn btn-dark" type="submit">Search events ↗</button><a class="btn btn-light" asp-action="Index">Reset</a></form>
@if (ViewBag.Error != null) { <div class="alert error">Could not load events from the API: @ViewBag.Error. Check that the Part 2 API is running.</div> }
@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">🏁</div><h3>No events match your search yet</h3><p>Try a different activity or city, or clear your filters.</p><a class="btn btn-dark" asp-action="Index">Show all events</a></div> } else { <div class="event-grid">@foreach (var e in Model) { <article class="event-card"><div class="event-art">@if (!string.IsNullOrWhiteSpace(e.BannerImageUrl)) { <img src="@e.BannerImageUrl" alt="@e.EventName banner"/> }<span>@e.EventType.ToUpperInvariant()</span></div><div class="event-body"><div><span class="tag">@e.EventStatus</span></div><h3>@e.EventName</h3><p>📍 @e.Venue, @e.City</p><div class="event-meta"><span>◷ @e.EventDate.ToString("dd MMM yyyy")</span><span>↗ @e.DistanceKm km</span><span>◉ @e.StartTime.ToString("HH:mm")</span></div><a class="btn btn-dark" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">View event details ↗</a></div></article> }</div> }
