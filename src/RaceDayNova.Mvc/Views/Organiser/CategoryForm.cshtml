@model CategoryFormModel
@{ ViewData["Title"] = "Create category"; }<div class="form-layout"><div class="section-head"><div><div class="eyebrow">CATEGORY MANAGEMENT</div><h1>Add a category</h1><p class="muted">Create an age group or race division.</p></div><a class="btn btn-light" asp-action="Categories">← Back</a></div><div class="form-card"><form asp-action="CreateCategory" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="field"><label asp-for="CategoryName"></label><input asp-for="CategoryName" placeholder="e.g. Under 20 / 10 km"/><span asp-validation-for="CategoryName" class="validation"></span></div><div class="form-grid"><div class="field"><label asp-for="AgeFrom">Minimum age (optional)</label><input asp-for="AgeFrom" type="number" min="0" max="120"/></div><div class="field"><label asp-for="AgeTo">Maximum age (optional)</label><input asp-for="AgeTo" type="number" min="0" max="120"/></div></div><div class="field"><label asp-for="CategoryNote">Category notes</label><textarea asp-for="CategoryNote" placeholder="Distance or eligibility details"></textarea></div><button class="btn" type="submit">Create category ↗</button></form></div></div>
