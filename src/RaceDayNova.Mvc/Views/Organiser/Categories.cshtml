@model List<CategoryDto>
@{ ViewData["Title"] = "Categories"; }<div class="section-head"><div><div class="eyebrow">EVENT CATEGORIES</div><h1>Categories library</h1><p class="muted">Set up age groups and distance divisions for your events.</p></div><a class="btn" asp-action="CreateCategory">＋ Add category</a></div>
@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">🏷</div><h3>No categories available</h3><p>Add a category to help participants choose their event division.</p><a class="btn" asp-action="CreateCategory">Add category</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Category</th><th>Age range</th><th>Notes</th><th>Action</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td><strong>@c.CategoryName</strong></td><td>@(c.AgeFrom?.ToString() ?? "—") – @(c.AgeTo?.ToString() ?? "—")</td><td>@c.CategoryNote</td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.CategoryId"/><button type="submit" class="btn btn-small btn-danger" data-confirm="Delete this category? Categories in use cannot be deleted.">Delete</button></form></td></tr> }</tbody></table></div> }
