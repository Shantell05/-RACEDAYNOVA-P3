@model List<EnrolmentDto>
@{ ViewData["Title"] = "Results entry"; }<div class="section-head"><div><div class="eyebrow">RACE DAY RESULTS</div><h1>Capture finishing results</h1><p class="muted">Record each participant's finishing position and time after the event.</p></div><a class="btn btn-light" asp-action="Events">← My events</a></div>@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">⏱</div><h3>No participants to score yet</h3><p>Entries for this event will appear here.</p></div> } else { <div class="table-wrap"><table><thead><tr><th>Participant</th><th>Category</th><th>Entry status</th><th>Position</th><th>Finish time</th><th>Result status</th><th>Save result</th></tr></thead><tbody>@foreach (var e in Model) { <tr><td><strong>@e.ParticipantName</strong><br/><small class="muted">@e.ParticipantEmail</small></td><td>@e.CategoryName</td><td><span class="status status-@e.EnrolmentStatus.ToLowerInvariant()">@e.EnrolmentStatus</span></td><td colspan="4"><form asp-action="SaveResult" method="post" class="actions"><input type="hidden" name="id" value="@ViewBag.EventId"/><input type="hidden" name="enrolmentId" value="@e.EnrolmentId"/><input name="positionNo" type="number" min="1" placeholder="Position" style="width:95px;padding:8px;border:1px solid #d6e0d6;border-radius:8px"/><input name="finishTime" type="text" placeholder="hh:mm:ss" style="width:110px;padding:8px;border:1px solid #d6e0d6;border-radius:8px"/><select name="resultStatus" style="padding:8px;border:1px solid #d6e0d6;border-radius:8px"><option>Finished</option><option>DNF</option><option>DNS</option><option>DSQ</option></select><button class="btn btn-small" type="submit">Save</button></form></td></tr> }</tbody></table></div> }
