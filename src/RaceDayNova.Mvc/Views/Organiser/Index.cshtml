@model List<EventDto>
@{ ViewData["Title"] = "Organiser dashboard"; }
<div class="section-head"><div><div class="eyebrow">ORGANISER WORKSPACE</div><h1>Your race-day overview</h1><p class="muted">Plan events, manage entries and keep every race moving.</p></div><a class="btn" asp-action="CreateEvent">＋ Create event</a></div>
<div class="stat-grid"><div class="stat-card"><span>EVENTS YOU MANAGE</span><strong>@ViewBag.TotalEvents</strong><small class="muted">Across your calendar</small></div><div class="stat-card"><span>UPCOMING EVENTS</span><strong>@ViewBag.Upcoming</strong><small class="muted">Ready for the start line</small></div><div class="stat-card"><span>TOTAL DISTANCE</span><strong>@(((decimal)ViewBag.TotalDistance).ToString("0.#"))<small> km</small></strong><small class="muted">Across your events</small></div></div>
<div class="section-head"><div><div class="eyebrow">YOUR CALENDAR</div><h2>Recently managed events</h2></div><a asp-action="Events">View all events ↗</a></div>
@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">🏁</div><h3>Your event calendar is ready</h3><p>Create your first event and start welcoming participants.</p><a class="btn" asp-action="CreateEvent">Create your first event</a></div> } else { <div class="event-grid">@foreach (var e in Model.OrderBy(x=>x.EventDate).Take(3)) { <article class="event-card"><div class="event-art">@if (!string.IsNullOrWhiteSpace(e.BannerImageUrl)) { <img src="@e.BannerImageUrl" alt="@e.EventName banner"/> }<span>@e.EventType.ToUpperInvariant()</span></div><div class="event-body"><span class="tag">@e.EventStatus</span><h3>@e.EventName</h3><p>📍 @e.City · @e.EventDate.ToString("dd MMM yyyy")</p><p><strong>@(((Dictionary<int,int>)ViewBag.EnrolmentCounts).GetValueOrDefault(e.EventId))</strong> participant entries</p><div class="actions"><a class="btn btn-small btn-dark" asp-action="EditEvent" asp-route-id="@e.EventId">Edit event</a><a class="btn btn-small btn-light" asp-action="EventCategories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-small btn-light" asp-action="Enrolments" asp-route-id="@e.EventId">Enrolments</a><a class="btn btn-small btn-light" asp-action="Results" asp-route-id="@e.EventId">Results</a></div></div></article> }</div> }
