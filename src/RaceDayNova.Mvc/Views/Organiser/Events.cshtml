@model List<EventDto>
@{ ViewData["Title"] = "Manage events"; }
<div class="section-head"><div><div class="eyebrow">EVENT MANAGEMENT</div><h1>Your events</h1><p class="muted">Create, update and manage every event you organise.</p></div><a class="btn" asp-action="CreateEvent">＋ New event</a></div>
@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">📅</div><h3>No events yet</h3><p>Create an event to start building your race calendar.</p><a class="btn" asp-action="CreateEvent">Create event</a></div> } else { <div class="table-wrap"><table><thead><tr><th>Event</th><th>Date & time</th><th>Location</th><th>Distance</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach (var e in Model) { <tr><td><strong>@e.EventName</strong><br/><small class="muted">@e.EventType</small></td><td>@e.EventDate.ToString("dd MMM yyyy")<br/><small class="muted">@e.StartTime.ToString("HH:mm")</small></td><td>@e.City, @e.Province</td><td>@e.DistanceKm km</td><td><span class="status status-@e.EventStatus.ToLowerInvariant()">@e.EventStatus</span></td><td><div class="actions"><a class="btn btn-small btn-light" asp-action="EditEvent" asp-route-id="@e.EventId">Edit</a><a class="btn btn-small btn-light" asp-action="EventCategories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-small btn-light" asp-action="Enrolments" asp-route-id="@e.EventId">Entries</a><a class="btn btn-small btn-light" asp-action="Results" asp-route-id="@e.EventId">Results</a><form asp-action="DeleteEvent" method="post"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-small btn-danger" data-confirm="Delete or cancel this event?" type="submit">Delete</button></form></div></td></tr> }</tbody></table></div> }
