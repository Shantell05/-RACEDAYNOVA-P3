@model List<EnrolmentDto>
@{ ViewData["Title"] = "Event enrolments"; }<div class="section-head"><div><div class="eyebrow">PARTICIPANT MANAGEMENT</div><h1>Event enrolments</h1><p class="muted">View who has entered this event and their selected category.</p></div><a class="btn btn-light" asp-action="Events">← My events</a></div>@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }@if (Model.Count == 0) { <div class="empty-state"><div class="symbol">👟</div><h3>No entries yet</h3><p>Participant entries will appear here once people enrol.</p></div> } else { <div class="table-wrap"><table><thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Entry fee</th><th>Status</th><th>Result</th></tr></thead><tbody>@foreach (var e in Model) { <tr><td><strong>@e.ParticipantName</strong><br/><small class="muted">@e.ParticipantEmail</small></td><td>@e.CategoryName</td><td>@e.EnrolledOn.ToString("dd MMM yyyy")</td><td>R @e.EntryFee.ToString("0.00")</td><td><span class="status status-@e.EnrolmentStatus.ToLowerInvariant()">@e.EnrolmentStatus</span></td><td>@(e.HasResult ? "Recorded" : "Not recorded")</td></tr> }</tbody></table></div> }
