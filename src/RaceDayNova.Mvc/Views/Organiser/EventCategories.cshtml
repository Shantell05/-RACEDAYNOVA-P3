@{ ViewData["Title"] = "Event categories"; var categories = ViewBag.Categories as List<CategoryDto> ?? new(); var attached = ViewBag.Attached as List<EventCategoryDto> ?? new(); }
<div class="section-head"><div><div class="eyebrow">EVENT SETUP</div><h1>Categories for @ViewBag.EventName</h1><p class="muted">Choose the divisions offered at this event and set entry fees and capacity.</p></div><a class="btn btn-light" asp-action="Events">← My events</a></div>
@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }
<section class="panel"><h2>Add a category</h2>@if (categories.Count == 0) { <p class="muted">Create a reusable category first.</p><a class="btn" asp-action="CreateCategory">Create category</a> } else { <form asp-action="AddEventCategory" method="post" class="form-grid"><input type="hidden" name="id" value="@ViewBag.EventId"/><div class="field"><label>Category</label><select name="categoryId" required>@foreach (var c in categories.Where(c=>!attached.Any(a=>a.CategoryId==c.CategoryId))) { <option value="@c.CategoryId">@c.CategoryName</option> }</select></div><div class="field"><label>Entry fee (R)</label><input name="entryFee" type="number" min="0" step="0.01" value="0" required/></div><div class="field"><label>Places available (optional)</label><input name="placesAvailable" type="number" min="1" placeholder="Unlimited if blank"/></div><div class="field" style="align-self:end"><button class="btn" type="submit">Add to event ↗</button></div></form> }</section>
<section class="panel"><h2>Available at this event</h2>@if (attached.Count == 0) { <p class="muted">No categories are attached to this event yet.</p> } else { <div class="table-wrap"><table><thead><tr><th>Category</th><th>Entry fee</th><th>Enrolments</th><th>Capacity</th><th>Action</th></tr></thead><tbody>@foreach (var c in attached) { <tr><td><strong>@c.CategoryName</strong></td><td>R @c.EntryFee.ToString("0.00")</td><td>@c.EnrolmentCount</td><td>@(c.PlacesAvailable?.ToString() ?? "Unlimited")</td><td><form asp-action="RemoveEventCategory" method="post"><input type="hidden" name="id" value="@ViewBag.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn btn-small btn-danger" type="submit" data-confirm="Remove this category from the event?">Remove</button></form></td></tr> }</tbody></table></div> }</section>
