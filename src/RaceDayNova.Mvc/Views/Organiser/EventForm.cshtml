@model EventFormModel
@{ var editing = Model.EventId > 0; ViewData["Title"] = editing ? "Edit event" : "Create event"; }
<div class="form-layout"><div class="section-head"><div><div class="eyebrow">EVENT MANAGEMENT</div><h1>@(editing ? "Edit your event" : "Create a new event")</h1><p class="muted">Add the details participants need to plan their race day.</p></div><a class="btn btn-light" asp-action="Events">← Back</a></div><div class="form-card"><form asp-action="@(editing ? "EditEvent" : "CreateEvent")" method="post" enctype="multipart/form-data"><input asp-for="EventId" type="hidden"/><input asp-for="BannerImageUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field full"><label asp-for="EventName"></label><input asp-for="EventName" placeholder="e.g. Pretoria Sunrise 10K"/><span asp-validation-for="EventName" class="validation"></span></div><div class="field"><label asp-for="EventType"></label><select asp-for="EventType"><option>Running</option><option>Walking</option><option>Cycling</option></select></div><div class="field"><label asp-for="DistanceKm">Distance (km)</label><input asp-for="DistanceKm" type="number" min="0.01" step="0.01"/><span asp-validation-for="DistanceKm" class="validation"></span></div><div class="field"><label asp-for="EventDate"></label><input asp-for="EventDate" type="date"/><span asp-validation-for="EventDate" class="validation"></span></div><div class="field"><label asp-for="StartTime"></label><input asp-for="StartTime" type="time"/><span asp-validation-for="StartTime" class="validation"></span></div><div class="field full"><label asp-for="Venue"></label><input asp-for="Venue" placeholder="Start / finish venue"/><span asp-validation-for="Venue" class="validation"></span></div><div class="field"><label asp-for="City"></label><input asp-for="City"/></div><div class="field"><label asp-for="Province"></label><input asp-for="Province"/></div><div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" placeholder="Tell participants what makes this event special..."></textarea></div><div class="field full"><label asp-for="RouteReference">Route link or reference</label><input asp-for="RouteReference" placeholder="Route URL or route details"/></div><div class="field"><label asp-for="EventStatus">Event status</label><select asp-for="EventStatus"><option value="Upcoming">Upcoming</option><option value="Open">Open</option><option value="Closed">Closed</option><option value="Completed">Completed</option><option value="Cancelled">Cancelled</option></select></div><div class="field"><label asp-for="BannerImage">Event banner image</label><input asp-for="BannerImage" type="file" accept="image/png,image/jpeg,image/webp"/><small class="muted">PNG, JPG or WebP. Uploads go through the API to Azure Blob Storage.</small></div></div><div class="form-actions"><button class="btn" type="submit">@(editing ? "Save changes" : "Create event") ↗</button><a class="btn btn-light" asp-action="Events">Cancel</a></div></form></div></div>
