@model RegisterViewModel
@{ ViewData["Title"] = "Create your account"; }<div class="auth-shell"><div class="auth-card"><div class="eyebrow">JOIN THE COMMUNITY</div><h1>Your next chapter starts here.</h1><p class="muted">Create an account to explore events, enter races and keep track of your results.</p><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="form-grid"><div class="field"><label asp-for="FirstName"></label><input asp-for="FirstName" autocomplete="given-name"/><span asp-validation-for="FirstName" class="validation"></span></div><div class="field"><label asp-for="LastName"></label><input asp-for="LastName" autocomplete="family-name"/><span asp-validation-for="LastName" class="validation"></span></div><div class="field full"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email" class="validation"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password"/><span asp-validation-for="Password" class="validation"></span></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="validation"></span></div><div class="field full"><label asp-for="Mobile"></label><input asp-for="Mobile" placeholder="+27..."/><span asp-validation-for="Mobile" class="validation"></span></div><div class="field full"><label asp-for="Role">I am joining as</label><select asp-for="Role" id="role"><option value="Participant">Participant — I want to enter events</option><option value="Organiser">Organiser — I want to manage events</option></select></div></div><button class="btn btn-dark" type="submit">Create my account ↗</button></form><p class="muted" style="text-align:center;margin-top:18px">Already registered? <a asp-action="Login">Log in</a></p></div></div>
