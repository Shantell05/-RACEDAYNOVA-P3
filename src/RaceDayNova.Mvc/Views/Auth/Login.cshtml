@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }<div class="auth-shell"><div class="auth-card"><div class="eyebrow">WELCOME BACK</div><h1>Good to see you.</h1><p class="muted">Sign in to continue your RaceDay Nova journey.</p><form asp-action="Login" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" placeholder="you@example.com"/><span asp-validation-for="Email" class="validation"></span></div><div class="field"><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" placeholder="Your password"/><span asp-validation-for="Password" class="validation"></span></div><button class="btn btn-dark" type="submit">Log in securely ↗</button></form><p class="muted" style="text-align:center;margin-top:20px">New to RaceDay Nova? <a asp-action="Register">Create an account</a></p></div></div>
